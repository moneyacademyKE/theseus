<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.theseus.ai-stock-brief</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/bb</string>
        <string>brief</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/moe/theseus/theseus</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>THESEUS_HOME</key>
        <string>/Users/moe/theseus</string>
        <key>PATH</key>
        <string>/Users/moe/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>5</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/moe/theseus/state/ai-brief/brief.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/moe/theseus/state/ai-brief/brief.launchd.err.log</string>
</dict>
</plist>
