<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theseus.schedule-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/moe/.local/bin/bb</string>
    <string>daemon</string>
    <string>start</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/moe/theseus/theseus</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>THESEUS_HOME</key>
    <string>/Users/moe/theseus</string>
