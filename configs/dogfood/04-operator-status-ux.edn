{:comment "Dogfood L4 -- improve operator status UX while preserving pure facts and status tests."
 :name "dogfood-04-operator-status-ux"
 :workdir "../goal-workspace"
 :lock "./.goal-dogfood-04.lock"
 :log-dir "./.goal-logs-dogfood-04"
 :models ["opencode-default"]
 :observers {:operator-tests-ok {:sh "./.tools/bin/bb -cp src:test -e \"(require 'bb-agent.goal.phase6-operator-test 'bb-agent.goal.phase6-operator-ux-test 'bb-agent.goal.status-test 'clojure.test) (let [r (clojure.test/run-tests 'bb-agent.goal.phase6-operator-test 'bb-agent.goal.phase6-operator-ux-test 'bb-agent.goal.status-test)] (System/exit (+ (:fail r) (:error r))))\" >/dev/null 2>&1 && echo pass || echo FAIL" :parse :string}
             :tests-ok {:sh "./.tools/bin/bb -cp src:test -m bb-agent.goal.run-tests >/dev/null 2>&1 && echo pass || echo FAIL" :parse :string}
             :build-ok {:sh "./.tools/bin/bb -e \"(require 'bb-agent.goal.status)\" >/dev/null 2>&1 && echo pass || echo fail" :parse :string}
             :status-lines {:sh "grep -R -E \"defn.*operator|format-summary|latest|hot-reload\" -n src/bb_agent/goal test/bb_agent/goal 2>/dev/null | wc -l | tr -d ' '" :parse :int}}
 :goal {:op :and
        :exprs [{:op := :ref :operator-tests-ok :value "pass"}
                {:op := :ref :tests-ok :value "pass"}]}
 :integrity-bundle :clj-build
 :progress [:operator-tests-ok :status-lines]
 :act {:harness :opencode
       :prompt "Improve the goal runner.s operator/status UX in a small, test-backed way. Good targets: clearer latest event display, active config/hot-reload wording, or harness/model visibility when present. Preserve pure operator facts and update tests. Do not add a TUI. Current operator tests={{operator-tests-ok}}, full suite={{tests-ok}}."}
 :checkpoint {:tag-prefix "goal-dogfood-04"}
 :stall-after 3
 :thrash-after 4
 :max-rollbacks 2
 :identical-retry-guard true}
