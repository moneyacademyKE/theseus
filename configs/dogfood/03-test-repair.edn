{:comment "Dogfood L3 -- targeted test repair. Use after deliberately breaking a small test on a disposable branch. Success is the full Babashka suite green."
 :name "dogfood-03-test-repair"
 :workdir "../goal-workspace"
 :lock "./.goal-dogfood-03.lock"
 :log-dir "./.goal-logs-dogfood-03"
 :models ["opencode-default"]
 :observers {:tests-ok {:sh "./.tools/bin/bb -cp src:test -m bb-agent.goal.run-tests >/dev/null 2>&1 && echo pass || echo FAIL" :parse :string}
             :build-ok {:sh "./.tools/bin/bb -e \"(require 'bb-agent.goal.core)\" >/dev/null 2>&1 && echo pass || echo fail" :parse :string}
             :fail-lines {:sh "./.tools/bin/bb -cp src:test -m bb-agent.goal.run-tests 2>&1 | grep -E -c 'FAIL in|ERROR in|expected:|actual:' | tr -d ' '" :parse :int}}
 :goal {:op := :ref :tests-ok :value "pass"}
 :integrity-bundle :clj-build
 :progress :fail-lines
 :act {:harness :opencode
       :prompt "Repair the goal-runner test suite. Run ./.tools/bin/bb -cp src:test -m bb-agent.goal.run-tests, inspect the failing test, and make the smallest correct code or test-fixture fix. Do not weaken assertions just to pass. the goal runner will ignore your self-report and rerun the suite. Current failing signal count={{fail-lines}}."}
 :checkpoint {:tag-prefix "goal-dogfood-03"}
 :stall-after 3
 :thrash-after 4
 :max-rollbacks 2
 :identical-retry-guard true}
